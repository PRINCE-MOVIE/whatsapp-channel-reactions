# Frontend environment example for Vercel (serverless API)

# If you want to use the integrated serverless API on Vercel, set DATABASE_URL to a Postgres DB (Supabase / Vercel Postgres / Render Postgres)
DATABASE_URL=postgres://username:password@host:5432/dbname

# Verify token for WhatsApp webhook verification
VERIFY_TOKEN=your_verify_token_here

# Optional: for sending messages
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
