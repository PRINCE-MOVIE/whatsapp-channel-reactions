# Port for the API
PORT=3000

# WhatsApp verification token (set the same value in Facebook dev console)
VERIFY_TOKEN=your_verify_token_here

# WhatsApp Cloud API
WHATSAPP_TOKEN= # Access token (optional, only if you want to send messages)
PHONE_NUMBER_ID= # Phone number id for Cloud API (optional)

# SQLite DB file path (optional)
DATABASE_PATH=./data.db
